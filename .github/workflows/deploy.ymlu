name: CI/CD Pipeline

on:
  push:
    branches:
      - master

jobs:
  check-changes:
    runs-on: self-hosted
    outputs:
      node: ${{ steps.filter.outputs.node }}
      java: ${{ steps.filter.outputs.java }}
      proxy: ${{ steps.filter.outputs.proxy }}
    steps:
      - name: Checkout repository
        uses: actions/checkout@v5

      - name: Detect changed paths
        id: filter
        uses: dorny/paths-filter@v4
        with:
          filters: |
            node:
              - 'node/**'
            java:
              - 'java/**'
            proxy:
              - 'nginx/**'
              - 'docker-compose.yml'

  code-scan:
    runs-on: self-hosted
    steps:
      - name: Checkout repository
        uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          fetch-depth: 0

      - name: SonarQube Scan
        uses: SonarSource/sonarqube-scan-action@7006c4492b2e0ee0f816d36501671557c97f5995 # v8.1.0
        env:
          SONAR_TOKEN: ${{ secrets.SONAR_TOKEN }}
          SONAR_HOST_URL: ${{ secrets.SONAR_HOST_URL }}

  release-java:
    needs: [check-changes, code-scan]
    if: needs.check-changes.outputs.java == 'true'
    runs-on: self-hosted
    steps:
      - name: Checkout repository
        uses: actions/checkout@v5

      - name: Build java-app image
        run: docker compose build java-app

      - name: Deploy java-app
        run: docker compose up -d java-app

      - name: Verify java-app is up
        run: |
          sleep 10
          docker compose exec -T java-app wget -qO- http://localhost:8080/

  release-node:
    needs: [check-changes, code-scan]
    if: needs.check-changes.outputs.node == 'true'
    runs-on: self-hosted
    steps:
      - name: Checkout repository
        uses: actions/checkout@v5

      - name: Build node-app image
        run: docker compose build node-app

      - name: Deploy node-app
        run: docker compose up -d node-app

      - name: Verify node-app is up
        run: |
          sleep 5
          docker compose exec -T node-app node -e "require('http').get('http://localhost:3000',r=>process.exit(r.statusCode===200?0:1))"

  release-proxy:
    needs: [check-changes, code-scan]
    if: needs.check-changes.outputs.proxy == 'true'
    runs-on: self-hosted
    steps:
      - name: Checkout repository
        uses: actions/checkout@v5

      - name: Recreate reverse-proxy with latest config
        run: docker compose up -d --force-recreate reverse-proxy

  verify-deployment:
    needs: [release-java, release-node, release-proxy]
    if: |
      always() &&
      (needs.release-java.result == 'success' ||
       needs.release-node.result == 'success' ||
       needs.release-proxy.result == 'success')
    runs-on: self-hosted
    steps:
      - name: Checkout repository
        uses: actions/checkout@v5

      - name: Ensure the full stack is running
        run: docker compose up -d

      - name: Check localhost/java
        run: |
          sleep 5
          curl -fsS http://localhost/java/

      - name: Check localhost/node
        run: curl -fsS http://localhost/node/
